# Local values are generated by `npm run supabase:env` after `npm run supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Setup and login remain local-only; workspace routes require a valid session.
EVERSHINE_AUTH_REQUIRED=1
