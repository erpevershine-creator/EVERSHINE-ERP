NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Keep disabled until the one-time Owner provisioning workflow is confirmed and completed.
EVERSHINE_AUTH_REQUIRED=0
