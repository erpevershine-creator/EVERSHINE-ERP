{
  "name": "evershine-erp-foundation",
  "version": "2.1.0-m2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/policy.test.ts tests/backup-crypto.test.mjs tests/backup-lock.test.mjs tests/retention.test.ts tests/retention-files.test.mjs tests/google-drive-oauth.test.mjs tests/offsite-key-shares.test.mjs tests/suppliers.test.ts",
    "test:e2e": "playwright test",
    "supabase:start": "node scripts/local-supabase.mjs start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "node scripts/local-supabase.mjs reset",
    "supabase:env": "node scripts/sync-local-supabase-env.mjs",
    "db:test": "supabase test db --local --network-id evershine-local-loopback",
    "db:lint": "supabase db lint --local --level warning"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.6.2",
    "supabase": "2.116.0",
    "typescript": "5.9.3"
  }
}
