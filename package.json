{
  "name": "evershine-erp-foundation",
  "version": "2.1.0-m1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
